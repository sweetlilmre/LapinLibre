#!/bin/sh
# SPDX-License-Identifier: MIT
# The RFID tag listener of the web API, kept running by immortaldog (/etc/init.d/S40lapinlibre).
# It follows rfid-daemon's tag_in signals only (a tag laid on the nose) and, for each:
# - while tag learning is on (rfid_start_record, at most 2 minutes): a tag the tag store doesn't
#   know is added to it, with the type and colour codes rfid-daemon read, and the LED flashes
#   green and a tone plays; a known tag gets a yellow flash and another tone. The learning pulse
#   comes back after each flash. No tone while the rabbit sleeps.
# - otherwise it gives every tag's feedback (the controller gives none): the LED red as soon as
#   the tag is read, then, first match wins:
#   - a stored tag with an action: a tone, the API's LED state again, then the action. A URL request is sent with curl (url_request: 15 s, 3 redirects, the body
#     thrown away; only the host and the outcome are logged); one of the API's endpoints is run
#     here with its stored query (api_run), so it applies all its own checks and its sleeping
#     rule;
#   - a tag an application's instance has (the controller's has_tag_app, asked only while it is
#     available): the same tone and LED, then the controller's start_tag_app starts it;
#   - a stored tag without an action: the error sound, the API's LED state again, then the
#     language's tag_no_action phrase;
#   - any other tag: the same with the language's tag_unknown phrase.
#   No light or sound while the rabbit sleeps or an application owns it (an interactive
#   application gets the tag from the controller). One tag at a time: a tag laid while one is
#   handled is ignored.
# The store's actions are data only: each is checked again when read (tags_read), and none is ever
# run as a shell command.
# It also follows the controller's state for the web API, so that no request has to ask the
# controller (which answers no one while it waits for its app server): the controller's
# karotz_status_changed signals, and the bus's NameOwnerChanged for its name. It writes the state
# to $WEB_CONTROLLER: the number, or empty while the controller isn't on the bus. When it starts,
# and when the controller comes onto the bus, it removes the file (requests then ask the
# controller themselves) and asks the controller in the background; the answer is written unless
# a signal came first. The file goes when the listener stops.
# It stays in the foreground. When its monitor ends (the bus went away) it exits 1, so immortaldog
# starts it again; SIGTERM ends the monitor and a running action, and it exits 0.
. /usr/share/lapinlibre/web.sh
LOG_TAG=tag_listener
# The controller's state comes from this listener's own file only (read_controller).
WEB_NO_ASK=1
RFID_PATH=/com/mindscape/karotz/Rfid
RFID_INTERFACE=com.mindscape.karotz.KarotzInterface
CONTROLLER_NAME=com.mindscape.karotz.Controller
CONTROLLER_PATH=/com/mindscape/karotz/Controller
# Only rfid-daemon's tag_in signals and the controller's state and name: never the whole bus.
RULE="type='signal',path='$RFID_PATH',interface='$RFID_INTERFACE',member='tag_in'"
RULE_STATE="type='signal',path='$CONTROLLER_PATH',interface='$RFID_INTERFACE',member='karotz_status_changed'"
RULE_OWNER="type='signal',sender='org.freedesktop.DBus',interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='$CONTROLLER_NAME'"
FIFO=$WEB_RUN/tag_listener.fifo.$$

exec < /dev/null > /dev/null 2>&1

log() { # log PRIORITY MESSAGE
    logger -t $LOG_TAG -p "user.$1" "$2"
}

# The running action's process, and its mark: the action removes the mark when it ends.
ACTION=
ACTION_MARK=$WEB_RUN/tag_action.$$

# action_running: true while the last action's process runs.
action_running() {
    jobs > /dev/null 2>&1 # reaps the finished children
    [ -n "$ACTION" ] && [ -e "$ACTION_MARK" ] && kill -0 "$ACTION" 2> /dev/null
}

# feedback COLOR AFTER [TONE [FUNCTION]]: the LED COLOR for a moment (none when COLOR is empty),
# then AFTER: "learn" (the learning pulse) or "state" (the API's LED state); the TONE meanwhile,
# unless the rabbit sleeps, waited for (at most 4 s) so that what follows has the sound device.
# Under the API's hardware lock (waited for at most 5 s, else skipped); nothing while an
# application owns the rabbit, and while it sleeps only the learning pulse. FUNCTION, when given,
# starts in the background once the lock is held, so its own start-up runs during the tone; an
# endpoint it runs waits for the lock (web_lock), so it drives the rabbit only after the tone and
# the LED. feedback returns once FUNCTION has ended (it runs even when the feedback is skipped).
feedback() {
    _fn=${4:-}
    read_controller
    case $CONTROLLER_STATE in 21 | 22) [ -n "$_fn" ] && $_fn; return 0 ;; esac
    read_api_state
    exec 9>> "$WEB_LOCK" || { [ -n "$_fn" ] && $_fn; return 0; }
    if ! timeout 5 flock -x 9; then
        exec 9>&-
        log warning "the rabbit is busy: no LED feedback"
        [ -n "$_fn" ] && $_fn
        return 0
    fi
    _fp=""
    if [ -n "$_fn" ]; then
        # The function's process mustn't hold the lock's descriptor, or its endpoint would wait
        # for itself.
        $_fn 9>&- &
        _fp=$!
    fi
    new_id
    _tone=""
    [ -n "${3:-}" ] && [ "$SLEEP" = 0 ] && [ -f "$3" ] && _tone=$3
    # The watch starts during the flash, so the flash isn't held back for it.
    [ -n "$_tone" ] && signal_watch Multimedia multi_playfinished nowait
    if [ -n "$1" ] && { [ "$SLEEP" = 0 ] || [ "$2" = learn ]; }; then
        led_set "$1" 0 && usleep 400000
    fi
    if [ -n "$_tone" ]; then
        # The watch in place first (dbus-monitor writes its own first lines then), at most 2 s.
        _w=0
        while [ $_w -lt 100 ] && [ ! -s "$WEB_MONITOR_OUT" ]; do
            usleep 20000
            _w=$((_w + 1))
        done
        tone "$_tone"
        signal_wait "$WEB_ID" 4 || log warning "the tone didn't end within 4 s"
        signal_stop
    fi
    if [ "$2" = learn ]; then
        led_learning
    else
        led_restore
    fi
    flock -u 9
    exec 9>&-
    [ -n "$_fp" ] && wait "$_fp"
    return 0
}

# seen: the LED red at once, the sign that a tag was read, before the controller is asked or
# anything is played; feedback or say_error sets the LED back. Under the API's hardware lock
# (waited for at most 5 s, else skipped); nothing while the rabbit sleeps or an application owns
# it.
seen() {
    read_controller
    case $CONTROLLER_STATE in 21 | 22) return 0 ;; esac
    read_api_state
    [ "$SLEEP" = 1 ] && return 0
    exec 9>> "$WEB_LOCK" || return 0
    if ! timeout 5 flock -x 9; then
        exec 9>&-
        return 0
    fi
    new_id
    led_set FF0000 0
    flock -u 9
    exec 9>&-
    return 0
}

# say_error KEY: the error sound, then the API's LED state again and the KEY phrase of the rabbit's
# language when its file has one. Under the API's hardware lock (waited for at most 5 s, else
# skipped); nothing while the rabbit sleeps or an application owns it.
say_error() {
    read_controller
    case $CONTROLLER_STATE in 21 | 22) return 0 ;; esac
    read_api_state
    [ "$SLEEP" = 1 ] && return 0
    lang_sound "$1"
    exec 9>> "$WEB_LOCK" || return 0
    if ! timeout 5 flock -x 9; then
        exec 9>&-
        log warning "the rabbit is busy: no sound"
        return 0
    fi
    new_id
    signal_watch Multimedia multi_playfinished
    tone "$WEB_TONE_ERROR"
    # The phrase only once the error sound has let go of the sound device.
    signal_wait "$WEB_ID" 4 || log warning "the error sound didn't end within 4 s"
    signal_stop
    led_restore
    [ -n "$LS" ] && tone "$LS"
    flock -u 9
    exec 9>&-
    return 0
}

# app_tag UID CONTENT APP TYPE PICT COLOR: true when an application's instance has the tag; its
# feedback is given, then the controller starts it. Only asked while the controller is
# available (it answers no one while it connects to its app server).
app_tag() {
    read_controller
    [ "$CONTROLLER_STATE" = 16 ] || return 1
    dbus_call Controller has_tag_app "string:$1" || return 1
    feedback "" state "$WEB_TONE_ACTION"
    if dbus_call Controller start_tag_app "string:$1" "string:$2" "int32:$3" "int32:$4" "int32:$5" "int32:$6"; then
        log info "tag $TG: its application started"
    else
        log warning "tag $TG: its application wasn't started"
    fi
    return 0
}

# the_action: the stored tag's action (its fields from tag_get).
the_action() {
    case $T_CMD in
    3)
        url_host "$T_A1"
        if ! valid_url "$T_A1"; then
            log err "tag $T_ID: its URL isn't valid: not sent"
        elif url_request "$T_A1" "$T_A2" "$T_A3" /dev/null; then
            log info "tag $T_ID: request to $UH: HTTP $UR_CODE"
        else
            log warning "tag $T_ID: request to $UH failed (curl status $?)"
        fi
        ;;
    5)
        if api_run "$T_A1" "$T_A2"; then
            log info "tag $T_ID: $T_A1 done"
        else
            log warning "tag $T_ID: $T_A1 failed: $AR_MSG"
        fi
        ;;
    esac
}

# One tag, in its own process (UID CONTENT APP TYPE PICT COLOR, with TG from valid_tag): the LED
# red first, then the tag looked up in the store (T_CMD empty for a tag that isn't stored, 0 for
# one without an action).
run_action() {
    exec 3<&-
    trap - TERM INT HUP
    seen
    if tag_get "$TG"; then
        case $T_CMD in 3 | 5) ;; *) T_CMD=0 ;; esac
    else
        T_CMD=""
    fi
    case $T_CMD in
    3 | 5) feedback "" state "$WEB_TONE_ACTION" the_action ;;
    *)
        if ! app_tag "$@"; then
            if [ -n "$T_CMD" ]; then
                log info "tag $TG: no action"
                say_error tag_no_action
            else
                log info "tag $TG: unknown"
                say_error tag_unknown
            fi
        fi
        rm -f "$ACTION_MARK"
        exit 0
        ;;
    esac
    feedback "" state
    rm -f "$ACTION_MARK"
    exit 0
}

# on_tag UID CONTENT APP TYPE PICT COLOR: a tag laid on the nose, with rfid-daemon's blocks and
# codes.
on_tag() {
    valid_tag "$1" || return 0
    if learning; then
        TAG_ID=$TG TAG_TYPE=-1 TAG_COLOR=-1
        case $4 in [0-9] | [0-9][0-9] | [0-9][0-9][0-9]) TAG_TYPE=$4 ;; esac
        case $6 in [0-9] | [0-9][0-9] | [0-9][0-9][0-9]) TAG_COLOR=$6 ;; esac
        tags_change add
        case $? in
        0)
            log info "tag $TG learned"
            feedback 00FF00 learn "$WEB_TONE_LEARNED"
            ;;
        4) feedback FFFF00 learn "$WEB_TONE_KNOWN" ;;
        *) log err "tag $TG: the tag store couldn't be written" ;;
        esac
        return 0
    fi
    if action_running; then
        log info "tag $TG: an action is still running: ignored"
        return 0
    fi
    # The codes go to the controller as int32 and the blocks as a string: anything else is
    # dropped.
    set -- "$1" "$2" "$3" "$4" "$5" "$6"
    case $2 in *[!0-9A-Fa-f:\;]*) set -- "$1" "" "$3" "$4" "$5" "$6" ;; esac
    for _c in "$3" "$4" "$5" "$6"; do
        case $_c in '' | *[!0-9-]* | ?*-*) return 0 ;; esac
    done
    : > "$ACTION_MARK"
    run_action "$@" &
    ACTION=$!
}

# controller_set STATE: the controller's state for the web API, replaced whole.
controller_set() {
    printf '%s\n' "$1" > "$WEB_CONTROLLER.$$" && mv -f "$WEB_CONTROLLER.$$" "$WEB_CONTROLLER"
}

ASK=
# controller_unknown: no state for the web API until the controller has answered (in the
# background, at most 6 s: it answers no one while it connects to its app server) or signalled.
controller_unknown() {
    controller_forget
    (
        exec 3<&-
        trap - TERM INT HUP
        controller_ask 6
        # Not once the listener has stopped ($$ is the listener's own process).
        kill -0 $$ 2> /dev/null || exit 0
        [ -e "$WEB_CONTROLLER" ] || controller_set "$CONTROLLER_STATE"
    ) &
    ASK=$!
}

# controller_forget: stops the last question to the controller, then removes the state file.
controller_forget() {
    [ -n "$ASK" ] && kill "$ASK" 2> /dev/null && wait "$ASK" 2> /dev/null
    rm -f "$WEB_CONTROLLER"
}

MON=
stop() {
    trap '' TERM INT HUP
    [ -n "$MON" ] && kill "$MON" 2> /dev/null
    action_running && kill "$ACTION" 2> /dev/null
    controller_forget
    rm -f "$FIFO" "$ACTION_MARK"
    log info "stopped"
    exit 0
}
trap stop TERM INT HUP

mkdir -p "$WEB_RUN"
rm -f "$FIFO"
if ! mkfifo -m 600 "$FIFO"; then
    log err "can't make $FIFO"
    exit 1
fi
dbus-monitor --system "$RULE" "$RULE_STATE" "$RULE_OWNER" > "$FIFO" 2> /dev/null &
MON=$!
exec 3< "$FIFO"
rm -f "$FIFO"
log info "started: dbus-monitor --system $RULE $RULE_STATE $RULE_OWNER"
controller_unknown

# dbus-monitor prints a header line per message ("signal ... path=P; interface=I; member=M") and
# one indented line per argument: tag_in's uid, blocks, app, type, picture and colour codes;
# karotz_status_changed's state; NameOwnerChanged's name, old owner and new owner.
kind= n=0
uid= blocks= app= type= pict=
while IFS= read -r line <&3; do
    case $line in
    "signal "*" path=$RFID_PATH; interface=$RFID_INTERFACE; member=tag_in")
        kind=tag n=1 uid= blocks= app= type= pict=
        ;;
    "signal "*" path=$CONTROLLER_PATH; interface=$RFID_INTERFACE; member=karotz_status_changed")
        kind=state n=1
        ;;
    "signal "*"; interface=org.freedesktop.DBus; member=NameOwnerChanged")
        kind=owner n=1
        ;;
    " "*)
        [ $n -gt 0 ] || continue
        n=$((n + 1))
        value=${line#"${line%%[! ]*}"}
        case $kind:$n:$value in
        tag:2:"string \""*\") value=${value#string \"}; uid=${value%\"} ;;
        tag:3:"string \""*\") value=${value#string \"}; blocks=${value%\"} ;;
        tag:3:"string "*) blocks= ;;
        tag:4:"int32 "*) app=${value#int32 } ;;
        tag:5:"int32 "*) type=${value#int32 } ;;
        tag:6:"int32 "*) pict=${value#int32 } ;;
        tag:7:"int32 "*)
            n=0
            on_tag "$uid" "$blocks" "$app" "$type" "$pict" "${value#int32 }"
            ;;
        state:2:"int32 "*)
            n=0
            value=${value#int32 }
            case $value in '' | *[!0-9]*) ;; *) controller_set "$value" ;; esac
            ;;
        owner:2:"string \"$CONTROLLER_NAME\"" | owner:3:"string "*) ;;
        owner:4:"string \"\"")
            n=0
            controller_set ""
            ;;
        owner:4:"string "*)
            n=0
            controller_unknown
            ;;
        *) n=0 ;;
        esac
        ;;
    *)
        n=0
        ;;
    esac
done
exec 3<&-
action_running && wait "$ACTION"
controller_forget
rm -f "$ACTION_MARK"
wait "$MON"
log err "the monitor ended (status $?): exiting"
exit 1
