# The controller's and the tag listener's sounds and sentences in Spanish; a key missing here is taken from en-US.
[lang]
# Played (after the error sound) when a tag is shown that neither an application nor the web API knows.
tag_unknown=/usr/karotz/sounds/es_tag_unknown.mp3
# Played when a tag is known but has no action yet (after the error sound).
tag_no_action=/usr/karotz/sounds/es_tag_no_action.mp3
# Played when speech recognition understood nothing, or named no application.
speech_no_match=/usr/karotz/sounds/es_speech_not_understood.mp3
speech_not_understood=/usr/karotz/sounds/es_speech_not_understood.mp3
