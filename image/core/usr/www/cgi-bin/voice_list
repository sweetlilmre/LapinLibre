#!/bin/sh
# SPDX-License-Identifier: MIT
# voice_list (read-only): the voice numbers tts takes whose language has a speech server in
# voice.conf, in order, each with its language and gender. The speech server has one voice per
# language, so both numbers of a language sound the same.
. /usr/share/lapinlibre/web.sh
web_begin read
read_tts_servers
items=""
n=1
# Each language in turn has two voice numbers: the odd one male, the even one female.
for lang in $VOICE_LANGS; do
    if has_tts_server "$lang"; then
        lang_name "$lang"
        json_str "$LN, male"
        items="$items${items:+,}{\"id\":\"$n\",\"lang\":$J}"
        json_str "$LN, female"
        items="$items,{\"id\":\"$((n + 1))\",\"lang\":$J}"
    fi
    n=$((n + 2))
done
reply_json "{\"voices\":[$items],\"return\":\"0\"}"
