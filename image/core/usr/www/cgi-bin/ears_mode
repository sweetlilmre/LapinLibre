#!/bin/sh
# SPDX-License-Identifier: MIT
# ears_mode: turns the API's own ear moves off or on (ears, ears_reset, ears_random, and the ears
# of sleep and wakeup); the controller still moves them for its own reasons. The setting is kept
# with the API's data on the flash, written only when it changes. Turning them on also
# recalibrates the ears, unless the rabbit sleeps or an application owns it.
#   disable  1 turns the moves off; anything else, or none, turns them on
. /usr/share/lapinlibre/web.sh
web_begin change
disable=0
param disable && [ "$PV" = 1 ] && disable=1

read_controller
read_api_state
reset=0
if [ "$disable" = 0 ] && [ "$SLEEP" = 0 ]; then
    case $CONTROLLER_STATE in 21 | 22) ;; *) reset=1 ;; esac
fi
if [ $reset = 1 ]; then
    web_lock
    new_id
fi
if [ "$disable" != "$EARS_DISABLED" ]; then
    if [ "$disable" = 1 ]; then
        mkdir -p "$WEB_DATA" && chmod 700 "$WEB_DATA" && : > "$WEB_DATA/ears_disabled" ||
            web_fail "the setting couldn't be saved"
    else
        rm -f "$WEB_DATA/ears_disabled" || web_fail "the setting couldn't be saved"
    fi
fi
if [ $reset = 1 ]; then
    dbus_call Ears reset "string:$WEB_ID" string:B || web_log "the ears couldn't be recalibrated"
    web_unlock
fi
web_ok
reply_json "{\"return\":\"0\",\"disabled\":\"$disable\"}"
