# SPDX-License-Identifier: MIT
# Buildroot 2026.02.3 configuration for the cross toolchain alone (system/toolchain/build.sh): GCC
# 14.3, binutils 2.44, uClibc-ng 1.0.57 with NPTL and wide characters, and Linux 2.6.32.71 headers,
# for the ARM920T with EABI and soft float. `make sdk` packs it; system/buildroot.config uses it
# as its external toolchain, with the same features declared. @DL_DIR@ and @PATCH_DIR@ are filled
# in by build.sh.
#
# Every download is pinned in config.toml (group "system") and fetched into DL_DIR first.
# Buildroot itself may fetch nothing.

BR2_arm=y
BR2_arm920t=y
BR2_ARM_EABI=y
BR2_DL_DIR="@DL_DIR@"
BR2_PRIMARY_SITE="http://127.0.0.1:9/"
BR2_PRIMARY_SITE_ONLY=y
BR2_GLOBAL_PATCH_DIR="@PATCH_DIR@"

BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
# The rabbit's loader options: /etc/ld.so.conf and ld.so.cache
BR2_UCLIBC_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LAPINLIBRE_PATH)/uclibc-ng.fragment"
BR2_PTHREADS_NATIVE=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v2.6/longterm/v2.6.32/linux-2.6.32.71.tar.xz"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_REALLY_OLD=y

# The toolchain only: no init system, shell, packages or root file system.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
# BR2_TARGET_ROOTFS_TAR is not set
