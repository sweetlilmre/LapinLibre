crypto/rand.h: no wait for /dev/random

On a kernel before 4.8 OpenSSL waits, before its first random byte, for
/dev/random to become readable. The Karotz's 2.6.32 has no entropy source:
the wait never ends, and wpa_supplicant's SAE (WPA3) hangs at its first commit.

--- a/include/crypto/rand.h
+++ b/include/crypto/rand.h
@@ -46,10 +46,12 @@
  */
 #define DEVRANDOM "/dev/urandom", "/dev/random", "/dev/hwrng", "/dev/srandom"
 #if defined(__linux) && !defined(__ANDROID__)
-#ifndef DEVRANDOM_WAIT
-#define DEVRANDOM_WAIT "/dev/random"
-#endif
 /*
+ * No DEVRANDOM_WAIT on the Karotz: its 2.6.32 has no entropy source, so
+ * /dev/random never becomes readable and the wait never ends. The start-up
+ * feeds /dev/urandom a seed kept across boots instead.
+ */
+/*
  * Linux kernels 4.8 and later changes how their random device works and there
  * is no reliable way to tell that /dev/urandom has been seeded -- getentropy(2)
  * should be used instead.
