arm: call without BLX on ARMv4T. libffi 3.4.8 assumes ARMv5T; the rabbit's ARM920T has no BLX, and ffi_call (GObject's marshalling, so dbus-glib) died there with SIGILL. All of the system build is ARM code, so the LDM returns need no interworking.

--- a/src/arm/sysv.S
+++ b/src/arm/sysv.S
@@ -123,7 +123,9 @@
 #ifndef __clang__
 	/* We require interworking on LDM, which implies ARMv5T,
 	   which implies the existance of BLX.  */
+# if __ARM_ARCH >= 5
  	.arch	armv5t
+# endif
 #endif
 
 	/* Note that we use STC and LDC to encode VFP instructions,
@@ -161,10 +163,19 @@
 	cfi_rel_offset(lr, 4)
 
 	mov	sp, r0		@ install the stack pointer
+#if __ARM_ARCH >= 5
 	mov	lr, r2		@ move the fn pointer out of the way
 	ldr	ip, [fp, #16]	@ install the static chain
 	ldmia	sp!, {r0-r3}	@ move first 4 parameters in registers.
 	blx	lr		@ call fn
+#else
+	@ ARMv4T has no BLX: call fn in ip. ip can't also carry the static
+	@ chain, which only Go closures (ffi_call_go) use.
+	mov	ip, r2
+	ldmia	sp!, {r0-r3}	@ move first 4 parameters in registers.
+	mov	lr, pc
+	bx	ip		@ call fn
+#endif
 
 	@ Load r2 with the pointer to storage for the return value
 	@ Load r3 with the return type code
