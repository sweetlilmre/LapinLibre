# SPDX-License-Identifier: MIT
# Buildroot 2026.02.3 configuration for the system build (system/build.sh): the
# toolchain (GCC 14.3, uClibc-ng 1.0.57 with NPTL, Linux 2.6.32.71 headers,
# ARM920T, EABI soft float; built by system/toolchain, used here as an external toolchain) and the
# rabbit's packages that need no LapinLibre change, at Buildroot's versions. @DL_DIR@ and @PATCH_DIR@ are filled in by
# build.sh (the patch directory: system/patches).
#
# The packages kept at old versions (the linphone stack, Python 2.4, libmpd, mpd 0.15,
# protobuf 2.3.0) are LapinLibre's own, in system/external; V8 is system/v8, and the
# Karotz programs and karotz-player are LapinLibre's userland (system/userland.sh).
#
# Every download is pinned in config.toml (group "system") and fetched into DL_DIR first.
# Buildroot itself may fetch nothing: its only site is unreachable, so a download that isn't
# pinned fails the build instead of being fetched.

BR2_arm=y
BR2_arm920t=y
BR2_ARM_EABI=y
BR2_DL_DIR="@DL_DIR@"
BR2_PRIMARY_SITE="http://127.0.0.1:9/"
BR2_PRIMARY_SITE_ONLY=y
BR2_GLOBAL_PATCH_DIR="@PATCH_DIR@"

# Toolchain: system/toolchain's (GCC 14.3, uClibc-ng 1.0.57 with NPTL, Linux 2.6.32.71 headers, with
# wide characters for GLib), unpacked at @TOOLCHAIN@ by system/toolchain/build.sh. The features
# declared here are the ones system/toolchain/buildroot.config builds; Buildroot checks them.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="@TOOLCHAIN@"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="$(ARCH)-buildroot-linux-uclibcgnueabi"
BR2_TOOLCHAIN_EXTERNAL_GCC_14=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_REALLY_OLD=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_NPTL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG is not set
# BR2_TOOLCHAIN_EXTERNAL_LOCALE is not set
# BR2_TOOLCHAIN_EXTERNAL_HAS_SSP is not set
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
# uClibc-ng's ldconfig and getconf, which an external toolchain doesn't install.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LAPINLIBRE_PATH)/post-build.sh"

# GNU gettext's libintl.so.8: GLib, bash and gpg link it. Buildroot
# builds gettext-gnu only with NLS.
BR2_SYSTEM_ENABLE_NLS=y

# The root: BusyBox, bash and the tools.
# SHOW_OTHERS: Buildroot hides bash and netcat while BusyBox is selected.
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# The rabbit's applets and features (system/external/busybox.config)
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_LAPINLIBRE_PATH)/busybox.config"
BR2_PACKAGE_BASH=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_DROPBEAR=y
# mDNS: the rabbit answers to its host name (<name>.local) and advertises SSH.
BR2_PACKAGE_MDNSD=y
BR2_PACKAGE_MDNSD_SSH_SERVICE=y
BR2_PACKAGE_LIBLOCKFILE=y
BR2_PACKAGE_LOCKFILE_PROGS=y
# GnuPG 1.4: RSA and AES among its algorithms, and only gpg itself (no gpgv or
# gpgsplit).
BR2_PACKAGE_GNUPG=y
BR2_PACKAGE_GNUPG_AES=y
BR2_PACKAGE_GNUPG_RSA=y
# crda with a current regulatory database: yaffs_start_functions.sh runs
# "iw reg set" and crda at every boot.
BR2_PACKAGE_CRDA=y
BR2_PACKAGE_WIRELESS_REGDB=y

# Libraries.
BR2_PACKAGE_LIBICONV=y
BR2_PACKAGE_GETTEXT=y
BR2_PACKAGE_GETTEXT_GNU=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL=y
# The openssl program.
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_DBUS_GLIB=y
BR2_PACKAGE_EXPAT=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_LIBGLIB2=y
# glib-compile-schemas on the target (Buildroot removes it).
BR2_PACKAGE_GLIB_COMPILE_SCHEMAS_KAROTZ=y
BR2_PACKAGE_LIBGCRYPT=y
BR2_PACKAGE_LIBGPG_ERROR=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y
# The libjpeg tools (cjpeg, djpeg, jpegtran, rdjpgcom, wrjpgcom).
BR2_PACKAGE_JPEG_TURBO_TOOLS=y
BR2_PACKAGE_LIBPNG=y

# Audio and video.
BR2_PACKAGE_FLAC=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_LIBVORBIS=y
# Fixed-point Ogg Vorbis for mpd: libvorbis is float, slower than real time on the ARM920T
BR2_PACKAGE_TREMOR=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_SPEEX=y
BR2_PACKAGE_SPEEXDSP=y
BR2_PACKAGE_LIBMAD=y
BR2_PACKAGE_MADPLAY=y
BR2_PACKAGE_LIBID3TAG=y
BR2_PACKAGE_LIBMMS=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
# FFmpeg for mpd and karotz-player: the audio decoders the rabbit plays with
# (aac_fixed for aac: fixed point on the FPU-less ARM920T) and demuxers, under FFmpeg 6.1's names;
# audio parsers; files, and http/https for karotz-player's URLs and web radio (with OpenSSL 3); for
# /usr/bin/ffmpeg, WAV out and the filters it needs. No devices and no external codec libraries
# (Buildroot would enable those it finds).
BR2_PACKAGE_FFMPEG_DECODERS="aac_fixed ac3 adpcm_4xm adpcm_adx adpcm_ct adpcm_ea adpcm_ea_maxis_xa adpcm_ea_r1 adpcm_ea_r2 adpcm_ea_r3 adpcm_ea_xas adpcm_g726 adpcm_ima_amv adpcm_ima_dk3 adpcm_ima_dk4 adpcm_ima_ea_eacs adpcm_ima_ea_sead adpcm_ima_iss adpcm_ima_qt adpcm_ima_smjpeg adpcm_ima_wav adpcm_ima_ws adpcm_ms adpcm_sbpro_2 adpcm_sbpro_3 adpcm_sbpro_4 adpcm_swf adpcm_thp adpcm_xa adpcm_yamaha adpcm_zork alac ape atrac3 cook dca dsicinaudio eac3 eightsvx_exp eightsvx_fib flac imc interplay_dpcm mace3 mace6 mlp mp1 mp2 mp3 mp3adu mp3on4 mpc7 mpc8 nellymoser pcm_alaw pcm_dvd pcm_f32be pcm_f32le pcm_f64be pcm_f64le pcm_mulaw pcm_s16be pcm_s16le pcm_s16le_planar pcm_s24be pcm_s24daud pcm_s24le pcm_s32be pcm_s32le pcm_s8 pcm_u16be pcm_u16le pcm_u24be pcm_u24le pcm_u32be pcm_u32le pcm_u8 qcelp qdm2 ra_144 ra_288 roq_dpcm shorten smackaud sol_dpcm sonic truespeech tta vmdaudio vorbis wavpack wmav1 wmav2 ws_snd1 xan_dpcm"
BR2_PACKAGE_FFMPEG_DEMUXERS="aac ac3 aiff amr apc ape asf ass au avi avs bethsoftvid bfi c93 cavsvideo daud dirac dnxhd dsicin dts dv dxa ea ea_cdata eac3 flac flic flv fourxm gsm gxf h261 h263 h264 idcin iff image2 image2pipe ingenient ipmovie iss lmlm4 m4v matroska mjpeg mlp mm mmf mov mp3 mpc mpc8 mpegps mpegts mpegtsraw mpegvideo msnwc_tcp mtv mvi mxf nc nsv nut nuv ogg oma pcm_alaw pcm_f32be pcm_f32le pcm_f64be pcm_f64le pcm_mulaw pcm_s16be pcm_s16le pcm_s24be pcm_s24le pcm_s32be pcm_s32le pcm_s8 pcm_u16be pcm_u16le pcm_u24be pcm_u24le pcm_u32be pcm_u32le pcm_u8 pva r3d rawvideo rl2 rm roq rpl rtsp sdp segafilm shorten siff smacker sol str swf thp tiertexseq tta txd vc1 vc1t vmd voc wav wc3 wsaud wsvqa wv xa yuv4mpegpipe"
BR2_PACKAGE_FFMPEG_PARSERS="aac ac3 adx cook dca flac gsm mlp mpegaudio vorbis"
BR2_PACKAGE_FFMPEG_PROTOCOLS="file pipe http https httpproxy tcp tls crypto"
BR2_PACKAGE_FFMPEG_ENCODERS="pcm_s16le"
BR2_PACKAGE_FFMPEG_MUXERS="wav"
BR2_PACKAGE_FFMPEG_FILTERS="abuffer abuffersink aformat anull aresample buffer buffersink format null"
BR2_PACKAGE_FFMPEG_BSFS="null"
# BR2_PACKAGE_FFMPEG_INDEVS is not set
# BR2_PACKAGE_FFMPEG_OUTDEVS is not set
BR2_PACKAGE_FFMPEG_EXTRACONF="--disable-libvorbis --disable-libtheora --disable-libspeex --disable-libxml2"

# Libraries kept at old versions, as packages of our own (system/external; protobuf stays at
# 2.3.0).
BR2_PACKAGE_PROTOBUF_KAROTZ=y
# libmpd with the Karotz changes (multimedia-daemon) and linphone 3.4.1 with oSIP2 and eXosip2 3.5.0
# (k2k-daemon).
BR2_PACKAGE_LIBMPD_KAROTZ=y
BR2_PACKAGE_MPD_KAROTZ=y
BR2_PACKAGE_LINPHONE_KAROTZ=y
# Python 2.4.5 with dbus-python 0.83.0 and simplejson 2.0.7, for the rabbit's scripts.
BR2_PACKAGE_PYTHON24_KAROTZ=y
BR2_PACKAGE_DBUS_PYTHON_KAROTZ=y
BR2_PACKAGE_SIMPLEJSON_KAROTZ=y

BR2_TARGET_ROOTFS_TAR=y
