# SPDX-License-Identifier: GPL-2.0-or-later
config BR2_PACKAGE_PROTOBUF_KAROTZ
	bool "protobuf-karotz"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Google's protocol buffers at 2.3.0 (libprotobuf.so.6), which
	  LapinLibre's controller,
	  voice-daemon and karotzVM use. Buildroot's own protobuf package is a much newer API.

	  https://github.com/protocolbuffers/protobuf
