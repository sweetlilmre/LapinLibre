+static int16_t
+float_to_s16(double f)
+{
+	long s = lrint(f * 32768.0);
+
+	return s > 32767 ? 32767 : s < -32768 ? -32768 : (int16_t)s;
+}
+
 /**
- * On some platforms, libavcodec wants the output buffer aligned to 16
- * bytes (because it uses SSE/Altivec internally).  This function
- * returns the aligned version of the specified buffer, and corrects
- * the buffer size.
+ * Sample @i of channel @c of @frame, as a signed 16-bit sample (what
+ * FFmpeg 0.5's decoders gave mpd 0.15).
  */
-static void *
-align16(void *p, size_t *length_p)
+static int16_t
+frame_sample_s16(const AVFrame *frame, int c, int i, int channels)
 {
-	unsigned add = 16 - (size_t)p % 16;
+	enum AVSampleFormat fmt = frame->format;
+	bool planar = av_sample_fmt_is_planar(fmt);
+	const uint8_t *data = frame->extended_data[planar ? c : 0];
+	int n = planar ? i : i * channels + c;
+
+	switch (av_get_packed_sample_fmt(fmt)) {
+	case AV_SAMPLE_FMT_U8:
+		return (int16_t)((data[n] - 128) << 8);
+	case AV_SAMPLE_FMT_S16:
+		return ((const int16_t *)data)[n];
+	case AV_SAMPLE_FMT_S32:
+		return (int16_t)(((const int32_t *)data)[n] >> 16);
+	case AV_SAMPLE_FMT_S64:
+		return (int16_t)(((const int64_t *)data)[n] >> 48);
+	case AV_SAMPLE_FMT_FLT:
+		return float_to_s16(((const float *)data)[n]);
+	case AV_SAMPLE_FMT_DBL:
+		return float_to_s16(((const double *)data)[n]);
+	default:
+		return 0;
+	}
+}
 
-	*length_p -= add;
-	return (char *)p + add;
+/**
+ * Interleaved 16-bit samples of @frame in @buffer (grown as needed);
+ * returns their size in bytes.
+ */
+static size_t
+frame_to_s16(const AVFrame *frame, int channels,
+	     int16_t **buffer, unsigned *buffer_size)
+{
+	size_t size = (size_t)frame->nb_samples * channels * sizeof(int16_t);
+
+	av_fast_malloc(buffer, buffer_size, size);
+	if (*buffer == NULL)
+		return 0;
+
+	int16_t *out = *buffer;
+	for (int i = 0; i < frame->nb_samples; ++i)
+		for (int c = 0; c < channels; ++c)
+			*out++ = frame_sample_s16(frame, c, i, channels);
+
+	return size;
 }
 
