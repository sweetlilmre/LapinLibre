+
+MpdData * mpd_database_get_genres(MpdObj *mi)
+{
+	char *string = NULL;
+	MpdData *data = NULL;
+	if(!mpd_check_connected(mi))
+	{
+		debug_printf(DEBUG_WARNING,"not connected\n");
+		return NULL;
+	}
+	if(mpd_lock_conn(mi))
+	{
+		debug_printf(DEBUG_ERROR,"lock failed\n");
+		return NULL;
+	}
+
+	mpd_sendListCommand(mi->connection,MPD_TABLE_GENRE,NULL);
+	while (( string = mpd_getNextGenre(mi->connection)) != NULL)
+	{
+		data = mpd_new_data_struct_append(data);
+		data->type = MPD_DATA_TYPE_TAG;
+		data->tag_type = MPD_TAG_ITEM_GENRE;
 		data->tag = string;
 	}
 	mpd_finishCommand(mi->connection);
