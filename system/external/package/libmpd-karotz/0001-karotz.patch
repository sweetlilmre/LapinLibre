+/* Karotz: every genre in the database, as MPD_DATA_TYPE_TAG data */
+MpdData *	mpd_database_get_genres		(MpdObj *mi);
 
 
 /**
--- a/src/libmpd-database.c
+++ b/src/libmpd-database.c
@@ -117,6 +117,40 @@
 		data = mpd_new_data_struct_append(data);
 		data->type = MPD_DATA_TYPE_TAG;
 		data->tag_type = MPD_TAG_ITEM_ALBUM;
+		data->tag = string;
+	}
+	mpd_finishCommand(mi->connection);
+
+	/* unlock */
