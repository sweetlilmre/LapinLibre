# RABBITV3: the I2S data-out pin (GPE4) is an I2S output only while transmitting; otherwise it is an input, so the codec sees no noise.
--- a/sound/soc/s3c24xx/s3c24xx-i2s.c
+++ b/sound/soc/s3c24xx/s3c24xx-i2s.c
@@ -98,6 +98,7 @@
 		iiscon  &= ~S3C2410_IISCON_TXIDLE;
 		iismod  |= S3C2410_IISMOD_TXMODE;
 
+		s3c2410_gpio_cfgpin(S3C2410_GPE4, S3C2410_GPE4_I2SSDO);
 		writel(iismod,  s3c24xx_i2s.regs + S3C2410_IISMOD);
 		writel(iisfcon, s3c24xx_i2s.regs + S3C2410_IISFCON);
 		writel(iiscon,  s3c24xx_i2s.regs + S3C2410_IISCON);
@@ -118,6 +119,7 @@
 		writel(iiscon,  s3c24xx_i2s.regs + S3C2410_IISCON);
 		writel(iisfcon, s3c24xx_i2s.regs + S3C2410_IISFCON);
 		writel(iismod,  s3c24xx_i2s.regs + S3C2410_IISMOD);
+		s3c2410_gpio_cfgpin(S3C2410_GPE4, S3C2410_GPIO_INPUT);
 	}
 
 	DBG("w: IISCON: %lx IISMOD: %lx IISFCON: %lx\n", iiscon, iismod, iisfcon);
