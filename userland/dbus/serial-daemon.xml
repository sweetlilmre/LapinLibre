<!-- Signal arguments are not listed: the generated server glue records only each signal's name, and the arguments are those the daemon's g_signal_new() declares. -->
<node>
  <interface name="com.mindscape.karotz.KarotzInterface">
    <method name="ping">
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="open">
      <arg name="port" type="s" direction="in"/>
      <arg name="baud" type="i" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="close">
      <arg name="port" type="s" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="write">
      <arg name="port" type="s" direction="in"/>
      <arg name="data" type="s" direction="in"/>
      <arg name="base" type="s" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="readlinemode">
      <arg name="port" type="s" direction="in"/>
      <arg name="base" type="s" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <signal name="readline"/>
    <signal name="registered"/>
  </interface>
</node>
