<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Signal arguments are not listed: the generated server glue records only each signal's name, and the arguments are those the daemon's g_signal_new() declares. -->
<node>
  <interface name="com.mindscape.karotz.KarotzInterface">
    <method name="k2k_call">
      <arg name="sipAddr" type="s" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="k2k_answer">
      <arg name="ans" type="b" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="k2k_hangup">
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="k2k_set_busy">
      <arg name="busy" type="b" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="k2k_set_answering_machine">
      <arg name="on" type="b" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="k2k_use_account">
      <arg name="sipId" type="s" direction="in"/>
      <arg name="sipDomain" type="s" direction="in"/>
      <arg name="sipPassword" type="s" direction="in"/>
      <arg name="stunServer" type="s" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <method name="k2k_echo_calibration">
      <arg name="result" type="b" direction="out"/>
    </method>
    <signal name="registered"/>
    <signal name="incoming_call"/>
    <signal name="beginning_call"/>
    <signal name="beginning_outgoing_call"/>
    <signal name="finished_call"/>
  </interface>
</node>
