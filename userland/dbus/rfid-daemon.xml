<!-- Signal arguments are not listed: the generated server glue records only each signal's name, and the arguments are those the daemon's g_signal_new() declares. -->
<node>
  <interface name="com.mindscape.karotz.KarotzInterface">
    <method name="getTags">
      <arg name="tags" type="s" direction="out"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <signal name="tag_in"/>
    <signal name="tag_out"/>
    <signal name="registered"/>
  </interface>
</node>
